PORT=4000
FRONTEND_URL=http://localhost:3000

# Local Postgres (matches docker-compose.yml). For Supabase/Neon paste their URL
# instead (Supabase pooler on port 6543 works: the app disables prepared statements).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/kingdom_of_chess

# Any long random string, e.g. `openssl rand -hex 32`
JWT_SECRET=change-me
